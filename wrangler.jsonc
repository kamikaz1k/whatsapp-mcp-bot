{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whatsapp-mcp-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The Agents SDK routes workflow callbacks by class name.
  "keep_names": true,
  // Per-deployment settings are secrets, so nothing about you lives in this file:
  // OWNER_NAME is how the bot names you to the model ("Ana").
  "secrets": {
    "required": ["OPENAI_API_KEY", "WA_API_SECRET", "WA_WEBHOOK_SECRET", "BOT_SECRET", "OWNER_NAME"],
  },
  // Generated images until they are sent. Created on the first deploy.
  "kv_namespaces": [{ "binding": "BOT_KV" }],
  // Subscriptions and token usage per reply (GET /usage). Created on the first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "whatsapp-mcp-bot" }],
  "durable_objects": {
    "bindings": [{ "name": "ChatAgent", "class_name": "ChatAgent" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatAgent"] }],
  "workflows": [
    { "name": "whatsapp-mcp-bot-reply", "binding": "REPLY_WORKFLOW", "class_name": "ReplyWorkflow" },
  ],
  // The whatsapp-mcp Worker, by its name on your account. Without this binding, set the
  // WA_API_URL secret to its URL instead (a Worker on another account).
  "services": [{ "binding": "WA", "service": "whatsapp-mcp" }],
  "vars": {
    // The whatsapp-mcp account id (the path segment after /accounts/).
    "WA_ACCOUNT": "personal",
    "OPENAI_MODEL": "gpt-6.1-terra",
    // Optional OpenAI project id (proj_…), sent as OpenAI-Project. Not needed with a key
    // that belongs to one project.
    "OPENAI_PROJECT": "",
    // "@you bot …" — the word after the mention.
    "TRIGGER_WORD": "bot",
    // Every reply starts with this; messages starting with it never trigger.
    "REPLY_PREFIX": "🤖",
    "ACK_EMOJI": "👀",
    "FAIL_EMOJI": "❌",
    // Reactions on your "bot subscribe" / "bot unsubscribe" once done.
    "SUBSCRIBED_EMOJI": "✅",
    "UNSUBSCRIBED_EMOJI": "🔕",
  },
}
